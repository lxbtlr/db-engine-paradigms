# VW_PROJ_COMPOUND chain kernels: writes ${out} (a .cpp listing one
# chainKernel instantiation per chain, see CompoundPrimitives.hpp) for
#   VW_COMPOUND_SET=full      every canonical chain of 2..VW_COMPOUND_DEPTH
#                             projections (depth <= 3: 432 + 10368 kernels)
#   VW_COMPOUND_SET=workload  the chains in ${list} (recorded with
#                             scripts/compound_workload.sh) up to the depth
# A chain is "op a b" then " ; <keep|reg> op form <l|r>" per further
# projection: ops plus minus mul, forms col sel val; keep/reg: the incoming
# intermediate is stored / stays in a register; l: the intermediate is the
# right operand (minus only). Canonical: a <= b in col sel val order unless
# the first op is minus, not both a and b val, r for plus and mul.

function(compound_template sig result)
  set(ops_plus Plus)
  set(ops_minus Minus)
  set(ops_mul Mul)
  set(forms_col Col)
  set(forms_sel Sel)
  set(forms_val Val)
  string(REPLACE " @ " ";" parts "${sig}")
  list(POP_FRONT parts first)
  string(REPLACE " " ";" f "${first}")
  list(GET f 0 op0)
  list(GET f 1 a)
  list(GET f 2 b)
  set(t "${ops_${op0}}, ${forms_${a}}, ${forms_${b}}")
  foreach(step IN LISTS parts)
    string(REPLACE " " ";" s "${step}")
    list(GET s 0 keep)
    list(GET s 1 op)
    list(GET s 2 form)
    list(GET s 3 side)
    set(left false)
    if(side STREQUAL "l")
      set(left true)
    endif()
    set(store false)
    if(keep STREQUAL "keep")
      set(store true)
    endif()
    string(APPEND t ", Step<${ops_${op}}, ${forms_${form}}, ${left}, ${store}>")
  endforeach()
  set(${result} "${t}" PARENT_SCOPE)
endfunction()

function(compound_all_chains depth result)
  set(forms col sel val)
  set(firsts "")
  foreach(op plus minus mul)
    foreach(ia RANGE 2)
      foreach(ib RANGE 2)
        if(ia EQUAL 2 AND ib EQUAL 2)
          continue()
        endif()
        if(NOT op STREQUAL "minus" AND ia GREATER ib)
          continue()
        endif()
        list(GET forms ${ia} a)
        list(GET forms ${ib} b)
        list(APPEND firsts "${op} ${a} ${b}")
      endforeach()
    endforeach()
  endforeach()
  set(steps "")
  foreach(keep keep reg)
    foreach(op plus minus mul)
      foreach(form col sel val)
        list(APPEND steps "${keep} ${op} ${form} r")
        if(op STREQUAL "minus")
          list(APPEND steps "${keep} ${op} ${form} l")
        endif()
      endforeach()
    endforeach()
  endforeach()
  set(all "")
  set(level "${firsts}")
  foreach(d RANGE 2 ${depth})
    set(next "")
    foreach(c IN LISTS level)
      foreach(s IN LISTS steps)
        list(APPEND next "${c} @ ${s}")
      endforeach()
    endforeach()
    list(APPEND all ${next})
    set(level "${next}")
  endforeach()
  set(${result} "${all}" PARENT_SCOPE)
endfunction()

function(compound_kernels depth set list out)
  if(set STREQUAL "full")
    compound_all_chains(${depth} chains)
  else()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${list}")
    # chains are held with " @ " for " ; ", which CMake lists cannot contain
    file(READ "${list}" content)
    string(REPLACE ";" "@" content "${content}")
    string(REPLACE "\n" ";" lines "${content}")
    set(chains "")
    set(deeper 0)
    foreach(line IN LISTS lines)
      string(STRIP "${line}" line)
      if(line STREQUAL "" OR line MATCHES "^#")
        continue()
      endif()
      if(NOT line MATCHES "^(plus|minus|mul) (col|sel|val) (col|sel|val)( @ (keep|reg) (plus|minus|mul) (col|sel|val) [lr])+$")
        string(REPLACE " @ " " ; " shown "${line}")
        message(FATAL_ERROR "${list}: not a chain: '${shown}'")
      endif()
      string(REGEX MATCHALL " @ " seps "${line}")
      list(LENGTH seps nsteps)
      if(nsteps GREATER_EQUAL depth)
        math(EXPR deeper "${deeper} + 1")
        continue()
      endif()
      list(APPEND chains "${line}")
    endforeach()
    list(REMOVE_DUPLICATES chains)
    if(deeper GREATER 0)
      message(STATUS "VW_COMPOUND: ${deeper} listed chains are deeper than ${depth}, skipped")
    endif()
  endif()
  list(LENGTH chains n)
  set(body "// generated by cmake/CompoundKernels.cmake: VW_COMPOUND_SET=${set}, VW_COMPOUND_DEPTH=${depth}\n")
  string(APPEND body "#include \"vectorwise/CompoundPrimitives.hpp\"\n\n")
  string(APPEND body "namespace vectorwise {\nnamespace primitives {\nnamespace compound {\n\n")
  string(APPEND body "const ChainEntry chainEntries[] = {\n")
  foreach(c IN LISTS chains)
    compound_template("${c}" t)
    string(REPLACE " @ " " ; " name "${c}")
    string(APPEND body "    {\"${name}\", &chainKernel<${t}>},\n")
  endforeach()
  string(APPEND body "    {nullptr, nullptr}};\nconst size_t chainEntryCount = ${n};\n\n")
  string(APPEND body "} // namespace compound\n} // namespace primitives\n} // namespace vectorwise\n")
  # rewrite only on change, so a reconfigure does not recompile the kernels
  file(WRITE "${out}.tmp" "${body}")
  configure_file("${out}.tmp" "${out}" COPYONLY)
  file(REMOVE "${out}.tmp")
  message(STATUS "VW_COMPOUND: ${n} chain kernels (VW_COMPOUND_SET=${set}, VW_COMPOUND_DEPTH=${depth})")
endfunction()
